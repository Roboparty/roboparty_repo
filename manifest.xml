<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="github" fetch="https://github.com/Roboparty/" />
  <default remote="github" revision="main" sync-j="4" />

  <!--
    BSP repositories: robot runtime, hardware drivers, tools and the base
    system image.  These projects are source trees used by the board support
    package and are kept under app/ (or image/) when synced.
  -->
  <project name="roboparty_all" path="deb/roboparty_all" />
  <project name="roboparty_base" path="deb/roboparty_base" />
  <project name="roboparty_bms" path="deb/roboparty_bms" />
  <project name="roboparty_camera" path="deb/roboparty_camera" />
  <project name="roboparty_description" path="deb/roboparty_description" />
  <project name="roboparty_dexhand" path="deb/roboparty_dexhand" />
  <project name="roboparty_example" path="deb/roboparty_example" />
  <project name="roboparty_start" path="deb/roboparty_start" />
  <project name="roboparty_imu" path="deb/roboparty_imu" revision="master" />
  <project name="roboparty_inference" path="deb/roboparty_inference" revision="master" />
  <project name="roboparty_lidar" path="deb/roboparty_lidar" />
  <project name="roboparty_motors" path="deb/roboparty_motors" revision="master" />
  <project name="roboparty_rp_head" path="deb/roboparty_rp_head" />
  <project name="roboparty_rp_server" path="deb/roboparty_rp_server" />

  <!-- Debian package repositories. -->
  <project name="robopi_addon" path="deb/robopi_addon" />
  <project name="robopi_config" path="deb/robopi_config" revision="trixie" />
  <project name="SOEM" path="deb/SOEM" />
  <!-- <project name="igh-deb" path="deb/igh-deb" revision="master" /> -->

  <!-- <project name="roboparty_image" path="bsp/roboparty_image" revision="next" /> -->
  <project name="roboparty_build" path="bsp/roboparty_build" />
  <!-- <project name="roboparty_rdk" path="bsp/roboparty_rdk" /> -->

</manifest>
